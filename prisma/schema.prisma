generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  rusher
  sniper
  support
  anchor
  lurker
}

enum UserType {
  player
  sponsor
  admin
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  displayName   String
  userType      UserType
  role          Role?
  gameUid       String?   // Free Fire UID — the handle players share in-game
  brRank        String?
  csRank        String?
  city          String    @default("Hyderabad")
  teamName      String?   // esports: player-declared squad/guild name (join record + profile default)
  visibleToSponsors Boolean @default(false)
  orgName       String?
  orgType       String?
  brandName     String?
  contact       String?
  consentedAt   DateTime?
  ageConfirmed  Boolean   @default(false)
  paidUntil     DateTime?
  postingPausedUntil DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  matches       Match[]        // matches this user posted
  entries       MatchEntry[]   // matches this user joined
  reports       Report[]       // matches this user reported
  series        MatchSeries[]  // series this user hosts
  sessions      Session[]
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Match {
  id          String   @id @default(cuid())
  organizerId String
  organizer   User     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  title       String
  mode        String   // casual | competitive | ranked | esports
  gameType    String   // BR | CS | BR/CS
  entry       String   // legacy taxonomy; new writes always 'free'
  entryFee    String?  // legacy column; always null on new writes
  prize       String   // legacy taxonomy; new writes always 'none'
  prizePool   String?  // legacy column; always null on new writes
  status      String   @default("open") // open | closed
  date        DateTime
  city        String
  online      Boolean  @default(false)
  slots       Int?
  contact     String?
  notes       String?
  endsAt      DateTime    // backfilled to `date + 90 min` by the MatchSeries migration (TP1); always present
  seriesId    String?
  series      MatchSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  entries     MatchEntry[]
  reports     Report[]

  @@index([status, date])
  @@unique([seriesId, date]) // Postgres allows multiple NULL seriesId — one-offs unaffected
}

model MatchSeries {
  id              String   @id @default(cuid())
  organizerId     String
  organizer       User     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  // template — mirrors /post's Match fields (plain Strings, same as Match)
  title           String
  mode            String   // casual | competitive | ranked | esports
  gameType        String   // BR | CS | BR/CS
  entry           String   // legacy taxonomy; new writes always 'free'
  entryFee        String?  // legacy column; always null on new writes
  prize           String   // legacy taxonomy; new writes always 'none'
  prizePool       String?  // legacy column; always null on new writes
  city            String
  online          Boolean  @default(false)
  slots           Int?
  durationMinutes Int      // 60 | 90 | 120 — from config.durationOptionsMinutes
  // recurrence (all date math uses the fixed +05:30 offset — never Intl)
  dayOfWeek       Int      // 0–6, IST calendar day
  startTimeLocal  String   // "HH:mm", e.g. "20:00"
  timezone        String   @default("Asia/Kolkata") // display only
  // lifecycle
  status          String   @default("active") // active | paused | archived
  lookaheadWeeks  Int      @default(2)
  lastGeneratedAt DateTime?
  resumedAt       DateTime?
  matches         Match[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

model MatchEntry {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId  String
  player    User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamName  String?  // esports: optional squad/guild name the player typed at join
  createdAt DateTime @default(now())

  @@unique([matchId, playerId])
}

model Report {
  id         String   @id @default(cuid())
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  category   String?
  reason     String
  createdAt  DateTime @default(now())

  @@unique([matchId, reporterId])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  segment   String   @default("organizer")
  city      String?
  createdAt DateTime @default(now())
}

model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())
  @@index([key, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  detail    String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
