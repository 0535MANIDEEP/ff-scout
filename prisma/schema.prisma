generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  rusher
  sniper
  support
  anchor
  lurker
}

enum UserType {
  player
  sponsor
  admin
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  displayName   String
  userType      UserType
  role          Role?
  gameUid       String?   // Free Fire UID — the handle players share in-game
  brRank        String?
  csRank        String?
  city          String    @default("Hyderabad")
  visibleToSponsors Boolean @default(false)
  orgName       String?
  orgType       String?
  brandName     String?
  contact       String?
  consentedAt   DateTime?
  ageConfirmed  Boolean   @default(false)
  paidUntil     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  matches       Match[]        // matches this user posted
  entries       MatchEntry[]   // matches this user joined
  reports       Report[]       // matches this user reported
}

model Match {
  id          String   @id @default(cuid())
  organizerId String
  organizer   User     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  title       String
  mode        String   // casual | competitive | ranked | esports
  gameType    String   // BR | CS | BR/CS
  entry       String   // free | paid
  entryFee    String?  // note only — players pay the organizer directly
  prize       String   // none | pool
  prizePool   String?  // note only — the organizer pays it directly
  status      String   @default("open") // open | closed
  date        DateTime
  city        String
  online      Boolean  @default(false)
  slots       Int?
  contact     String?
  notes       String?
  createdAt   DateTime @default(now())
  entries     MatchEntry[]
  reports     Report[]

  @@index([status, date])
}

model MatchEntry {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId  String
  player    User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([matchId, playerId])
}

model Report {
  id         String   @id @default(cuid())
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  createdAt  DateTime @default(now())

  @@unique([matchId, reporterId])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  segment   String   @default("organizer")
  city      String?
  createdAt DateTime @default(now())
}

model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())
  @@index([key, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  detail    String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
