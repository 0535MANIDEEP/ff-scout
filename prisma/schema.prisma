generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  rusher
  sniper
  support
  anchor
  lurker
}

enum UserType {
  player
  organizer
  admin
  moderator
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  displayName   String
  userType      UserType
  role          Role?
  college       String?
  city          String    @default("Hyderabad")
  rank          String    @default("Heroic")
  verified      Boolean   @default(false)
  status        String    @default("looking")
  orgName       String?
  orgType       String?
  consentedAt   DateTime?
  ageConfirmed  Boolean   @default(false)
  iglCapable    Boolean   @default(false)
  paidUntil     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  proofs        VerificationProof[]
  matches       Match[]
}

model VerificationProof {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  fileData   String?  // base64 PNG — fallback when Cloudinary envs are unset (dev mode)
  fileUrl    String?  // Cloudinary secure_url — used in production
  publicId   String?  // Cloudinary public_id — needed for purge/delete
  fileName   String
  mimeType   String
  gameUid    String?  // Free Fire UID — the one cross-check organizers own
  reviewerNote String? // optional admin note, shown to player on reject
  status     String   @default("pending") // pending | approved | rejected
  createdAt  DateTime @default(now())
  reviewedAt DateTime?
  reviewerId String?
}

model Match {
  id         String   @id @default(cuid())
  playerId   String
  player     User     @relation(fields: [playerId], references: [id])
  orgId      String
  accepted   Boolean  @default(false)
  paidAt     DateTime?
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  segment   String   @default("organizer")
  city      String?
  createdAt DateTime @default(now())
}

model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())
  @@index([key, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  detail    String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
