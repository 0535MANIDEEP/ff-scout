# --- Final Circle environment template ---
# Dev: copy to .env.local (Next) and .env (prisma CLI). Both are gitignored.
# Production: set these in the hosting dashboard. Never commit filled-in values.

# PostgreSQL connection string. Use a scratch database locally — never production.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Optional: canonical site URL used for metadata/robots/sitemap.
# Set this to the real deployment origin before launch; the default is a placeholder.
# NEXT_PUBLIC_SITE_URL=https://finalcircle.example

# Required before launch: the public contact address shown on /safety, /terms,
# /privacy, /advertise and the footer. Set it to the operator's monitored mailbox.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Optional: sponsor line shown in the footer when a placement is active.
# SPONSOR_LINE=
