# --- FF Scout environment template ---
# Dev: copy to .env.local (Next) and .env (prisma CLI). Both are gitignored.
# Production: set these in the hosting dashboard (Vercel → Project → Environment Variables).

# PostgreSQL connection string. Production uses Neon (ap-southeast-1), created via
# the Vercel Marketplace integration. Local dev: same file, point at a scratch
# database — never at production.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Session signing key for the JWT cookie (jose, HS256). REQUIRED in production —
# the app refuses to sign/verify sessions without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_SECRET=

# Proof screenshot storage — Cloudinary free tier (25 credits/month, no card).
# Unset → proofs stored inline in Postgres as base64 (dev mode only).
# Set these in Vercel Production to switch uploads to Cloudinary.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional: canonical site URL used for metadata/robots/sitemap (defaults to https://ff-scout.vercel.app)
# NEXT_PUBLIC_SITE_URL=https://ff-scout.vercel.app
